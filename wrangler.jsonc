{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "joy-health",
  "main": "./worker/index.ts",
  "compatibility_date": "2026-08-20",
  "compatibility_flags": ["nodejs_compat"],
  "workers_dev": false,
  "routes": [
    {
      "pattern": "joyhealth.cc",
      "custom_domain": true
    },
    {
      "pattern": "www.joyhealth.cc",
      "custom_domain": true
    }
  ],
  "assets": {
    "binding": "ASSETS",
    "run_worker_first": true
  },
  "observability": {
    "enabled": true
  }
}
