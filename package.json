{
  "name": "joy-health",
  "version": "0.1.0",
  "description": "Plain-language nutrition guides that cite their sources.",
  "private": true,
  "license": "Apache-2.0",
  "homepage": "https://joyhealth.cc",
  "engines": {
    "node": ">=22.13.0"
  },
  "scripts": {
    "dev": "WRANGLER_LOG_PATH=.wrangler/wrangler.log vinext dev",
    "build": "WRANGLER_LOG_PATH=.wrangler/wrangler.log vinext build",
    "postbuild": "node scripts/build-agent-files.mjs",
    "start": "WRANGLER_LOG_PATH=.wrangler/wrangler.log vinext start",
    "deploy": "npm run check && npm run deploy:worker",
    "deploy:worker": "wrangler deploy --config dist/server/wrangler.json",
    "pretest": "npm run build",
    "test": "node --test tests/rendered-html.test.mjs",
    "lint": "eslint . --ignore-pattern dist --ignore-pattern .next",
    "typecheck": "tsc --noEmit",
    "images:generate": "node scripts/generate-responsive-images.mjs",
    "images:check": "node scripts/generate-responsive-images.mjs --check",
    "check": "npm run images:check && npm run lint && npm run typecheck && npm test",
    "seo:audit": "node scripts/audit-seo.mjs",
    "aeo:probe": "node scripts/aeo-probe.mjs",
    "indexnow": "node scripts/indexnow.mjs",
    "audit": "npm audit --audit-level=high"
  },
  "dependencies": {
    "react": "19.3.0",
    "react-dom": "19.3.0"
  },
  "devDependencies": {
    "@cloudflare/vite-plugin": "1.57.1",
    "@eslint/js": "10.0.1",
    "@next/eslint-plugin-next": "16.3.5",
    "@types/node": "26.6.2",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.1.1",
    "@vitejs/plugin-rsc": "0.5.35",
    "eslint": "10.11.0",
    "eslint-plugin-jsx-a11y": "6.10.2",
    "eslint-plugin-react": "7.37.5",
    "eslint-plugin-react-hooks": "7.1.1",
    "globals": "17.12.0",
    "react-server-dom-webpack": "19.3.0",
    "sharp": "0.35.4",
    "typescript": "7.0.2",
    "typescript-eslint": "8.70.1",
    "vinext": "1.0.0-beta.11",
    "vite": "8.3.0",
    "wrangler": "4.136.1"
  },
  "type": "module"
}
